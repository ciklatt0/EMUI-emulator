    /bb/echo "dir.system = /system/lib64/" >> "$CFG"
    /bb/echo "dir.vendor = /vendor/bin/" >> "$CFG"
    /bb/echo "dir.vendor = /vendor/lib64/" >> "$CFG"
    /bb/echo "" >> "$CFG"
    /bb/echo "[system]" >> "$CFG"
    /bb/echo "namespace.default.isolated = false" >> "$CFG"
    /bb/echo "namespace.default.visible = true" >> "$CFG"
    /bb/echo "namespace.default.search.paths = /system/bin:/system/lib64:/vendor/bin:/vendor/lib64" >> "$CFG"
    /bb/echo "namespace.default.permitted.paths = /system/bin:/system/lib64:/vendor/bin:/vendor/lib64" >> "$CFG"
    for entry in  6:com.android.adbd 7:com.android.apex.cts.shim 8:com.android.appsearch 9:com.android.art 10:com.android.conscrypt 11:com.android.extservices 12:com.android.i18n 13:com.android.ipsec 14:com.android.media.swcodec 15:com.android.media 16:com.android.mediaprovider 17:com.android.neuralnetworks 18:com.android.os.statsd 19:com.android.permission 20:com.android.resolv 21:com.android.runtime 22:com.android.scheduling 23:com.android.sdkext 24:com.android.tethering.inprocess 25:com.android.tzdata 26:com.android.vndk.current 27:com.android.wifi 28:payload; do
